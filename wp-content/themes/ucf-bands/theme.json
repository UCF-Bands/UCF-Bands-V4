{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"name": "Gold",
					"slug": "gold",
					"color": "var(--ucf--color--gold)"
				},
				{
					"name": "Black",
					"slug": "black",
					"color": "var(--ucf--color--black)"
				},
				{
					"name": "Gray",
					"slug": "gray",
					"color": "var(--ucf--color--gray)"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "var(--ucf--color--white)"
				}
			],
			"gradients": [
				{
					"name": "White / Light Gray",
					"slug": "lightest-gray",
					"gradient": "var(--ucf--gradient--lightest-gray)"
				},
				{
					"name": "Light Gray",
					"slug": "light-gray",
					"gradient": "var(--ucf--gradient--light-gray)"
				},
				{
					"name": "Dark Gray",
					"slug": "dark-gray",
					"gradient": "var(--ucf--gradient--dark-gray)"
				},
				{
					"name": "Gold",
					"slug": "gold",
					"gradient": "var(--ucf--gradient--gold)"
				},
				{
					"name": "Dark Gray Overlay (For Images): Right",
					"slug": "dark-gray-overlay",
					"gradient": "var(--ucf--gradient--dark-gray-overlay)"
				},
				{
					"name": "Dark Gray Overlay (For Images): Left",
					"slug": "dark-gray-overlay-to-right",
					"gradient": "var(--ucf--gradient--dark-gray-overlay-to-right)"
				}
			],
			"link": true
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontWeight": false,
			"fontStyle": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Open Sans\", sans-serif",
					"name": "Open Sans",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "Open Sans",
							"fontStyle": "auto",
							"fontWeight": "400 700",
							"src": [ "file:./src/fonts/opensans-variable.ttf" ]
						},
						{
							"fontFamily": "Open Sans",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"src": [ "file:./src/fonts/opensans-italic-variable.ttf" ]
						}
					]
				},
				{
					"fontFamily": "\"Montserrat\", sans-serif",
					"name": "Montserrat",
					"slug": "body-alt",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontWeight": "600",
							"src": [ "file:./src/fonts/montserrat-bold.ttf" ]
						}
					]
				},
				{
					"fontFamily": "\"League Gothic\", sans-serif",
					"name": "League Gothic",
					"slug": "display",
					"fontFace": [
						{
							"fontFamily": "League Gothic",
							"fontWeight": "400",
							"src": [ "file:./src/fonts/leaguegothic-regular.ttf" ]
						}
					]
				},
				{
					"fontFamily": "\"Droid Serif\", serif",
					"name": "Droid Serif",
					"slug": "serif",
					"fontFace": [
						{
							"fontFamily": "Droid Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [ "file:./src/fonts/droidserif-italic.ttf" ]
						},
						{
							"fontFamily": "Droid Serif",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [ "file:./src/fonts/droidserif-bolditalic.ttf" ]
						}
					]
				}
			],
			"letterSpacing": false,
			"textTransform": false,
			"textDecoration": false,
			"textIndent": false,
			"dropCap": false
		},
		"layout": {
			"contentSize": "var(--ucf--content-width--default)",
			"wideSize": "var(--ucf--content-width--wide)"
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "1 Unit",
					"slug": "40",
					"size": "2.125rem"
				}
			]
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamilies": []
				}
			},
			"core/paragraph": {
				"typography": {
					"fontFamilies": [],
					"fontSizes": []
				}
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"lineHeight": "1.6",
			"fontSize": "var(--ucf--font-size--16)",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|body-alt",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"lineHeight": "0.875",
					"fontSize": "var(--ucf--font-size--62-fluid)",
					"fontWeight": "400",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--ucf--font-size--46-fluid)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--ucf--font-size--32-fluid)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--ucf--font-size--28-fluid)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--ucf--font-size--18-fluid)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--ucf--font-size--14)"
				}
			}
		},
		"spacing": {
			"blockGap": "2.125rem"
		}
	}
}
