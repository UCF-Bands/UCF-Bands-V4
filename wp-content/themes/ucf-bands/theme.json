{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{
					"name": "Gold",
					"slug": "gold",
					"color": "var(--ucf--color--gold)"
				},
				{
					"name": "Black",
					"slug": "black",
					"color": "var(--ucf--color--black)"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "var(--ucf--color--white)"
				}
			],
			"gradients": [],
			"link": true
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontWeight": false,
			"fontStyle": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Open Sans\", sans-serif",
					"name": "Open Sans",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "Open Sans",
							"fontStyle": "auto",
							"fontWeight": "400 700",
							"src": [ "file:./src/fonts/opensans-variable.ttf" ]
						},
						{
							"fontFamily": "Open Sans",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"src": [ "file:./src/fonts/opensans-italic-variable.ttf" ]
						}
					]
				},
				{
					"fontFamily": "\"Montserrat\", sans-serif",
					"name": "Montserrat",
					"slug": "body-alt",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontWeight": "600",
							"src": [ "file:./src/fonts/montserrat-bold.ttf" ]
						}
					]
				},
				{
					"fontFamily": "\"League Gothic\", sans-serif",
					"name": "League Gothic",
					"slug": "display",
					"fontFace": [
						{
							"fontFamily": "League Gothic",
							"fontWeight": "400",
							"src": [ "file:./src/fonts/leaguegothic-regular.ttf" ]
						}
					]
				},
				{
					"fontFamily": "\"Droid Serif\", serif",
					"name": "Droid Serif",
					"slug": "serif",
					"fontFace": [
						{
							"fontFamily": "Droid Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [ "file:./src/fonts/droidserif-italic.ttf" ]
						},
						{
							"fontFamily": "Droid Serif",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [ "file:./src/fonts/droidserif-bolditalic.ttf" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Base",
					"slug": "base",
					"size": "1.125rem"
				},
				{
					"name": "Jumbo",
					"slug": "jumbo",
					"size": "7.875rem"
				}
			],
			"letterSpacing": false,
			"textTransform": false,
			"textDecoration": false,
			"textIndent": false,
			"dropCap": false
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamilies": [],
					"fontSizes": []
				}
			},
			"core/paragraph": {
				"typography": {
					"fontFamilies": [],
					"fontSizes": []
				}
			}
		},
		"layout": {
			"contentSize": "54.375rem",
			"wideSize": "81.875rem"
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "1 Unit",
					"slug": "40",
					"size": "2.125rem"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"lineHeight": "1.6",
			"fontSize": "var:preset|font-size|base",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|body-alt",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"lineHeight": "0.875",
					"fontSize": "var:preset|font-size|jumbo",
					"fontWeight": "400",
					"textTransform": "uppercase"
				}
			}
		},
		"spacing": {
			"blockGap": "2.125rem"
		}
	}
}
