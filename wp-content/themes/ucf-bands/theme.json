{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [],
			"gradients": [],
			"link": true
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontWeight": false,
			"fontStyle": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Open Sans\", sans-serif",
					"name": "Open Sans",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "Open Sans",
							"fontStyle": "auto",
							"fontWeight": "400 700",
							"src": [ "file:./src/fonts/opensans-variable.ttf" ]
						},
						{
							"fontFamily": "Open Sans",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"src": [ "file:./src/fonts/opensans-italic-variable.ttf" ]
						}
					]
				},
				{
					"fontFamily": "\"Droid Serif\", serif",
					"name": "Droid Serif",
					"slug": "serif",
					"fontFace": [
						{
							"fontFamily": "Droid Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [ "file:./src/fonts/droidserif-italic.ttf" ]
						},
						{
							"fontFamily": "Droid Serif",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [ "file:./src/fonts/droidserif-bolditalic.ttf" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Temp",
					"slug": "temp",
					"size": "14px"
				}
			]
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamilies": []
				}
			},
			"core/paragraph": {
				"typography": {
					"fontFamilies": []
				}
			}
		},
		"layout": {
			"contentSize": "54.375rem",
			"wideSize": "81.875rem"
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontWeight": "400"
		}
	}
}
